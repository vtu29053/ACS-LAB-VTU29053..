import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[][] a = new int[n][2];
        for (int i = 0; i < n; i++) {
            a[i][0] = sc.nextInt();
            a[i][1] = sc.nextInt();
        }
        Arrays.sort(a, (x, y) -> x[1] - y[1]);
        int count = 0, lastEnd = 0;
        for (int i = 0; i < n; i++) {
            if (a[i][0] >= lastEnd) {
                count++;
                lastEnd = a[i][1];
            }
        }
        System.out.println("MaximumEvents = " + count);
        sc.close();
    }
}
Input:
6
1 3
2 5
4 6
6 7
5 8
8 10
Output:
MaximumEvents = 4
