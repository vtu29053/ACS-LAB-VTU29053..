import java.util.*;
public class Main {
    static class Node {
        int data;
        Node left, right;

        Node(int data) {
            this.data = data;
        }
    }
    static Node buildTree(int[] a, int i) {
        if (i >= a.length) {
            return null;
        }
        Node root = new Node(a[i]);
        root.left = buildTree(a, 2 * i + 1);
        root.right = buildTree(a, 2 * i + 2);
        return root;
    }
    static int height(Node root) {
        if (root == null) {
            return -1;
        }
        int left = height(root.left);
        int right = height(root.right);
        return 1 + Math.max(left, right);
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] a = new int[n];
        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }
        Node root = buildTree(a, 0);
        int h = height(root);
        int levels = h + 1;
        System.out.println("Height of the tree: " + h);
        System.out.println("Total number of levels: " + levels);
        sc.close();
    }
}
Input:
7
50 30 80 20 60 40 70
Output:
Height = 2
Levels = 3
