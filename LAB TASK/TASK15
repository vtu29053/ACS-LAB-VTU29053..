import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int W = sc.nextInt();
        int[] wt = new int[n];
        int[] val = new int[n];
        int[][] dp = new int[n + 1][W + 1];
        for (int i = 0; i < n; i++) {
            wt[i] = sc.nextInt();
            val[i] = sc.nextInt();
        }
        for (int i = 1; i <= n; i++) {
            for (int w = 0; w <= W; w++) {
                dp[i][w] = dp[i - 1][w];
                if (wt[i - 1] <= w) {
                    dp[i][w] = Math.max(dp[i][w],
                        dp[i - 1][w - wt[i - 1]] + val[i - 1]);
                }
            }
        }
        System.out.println("MaximumValue = " + dp[n][W]);
        ArrayList<Integer> items = new ArrayList<>();
        int w = W;
        for (int i = n; i > 0; i--) {
            if (dp[i][w] != dp[i - 1][w]) {
                items.add(i);
                w -= wt[i - 1];
            }
        }
        Collections.reverse(items);
        System.out.println("SelectedItems:");
        for (int item : items) {
            System.out.print(item + " ");
        }
        System.out.println();
        sc.close();
    }
}
